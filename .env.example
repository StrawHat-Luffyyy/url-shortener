DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
TEST_DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener_test
TEST_REDIS_URL=redis://localhost:6379/1
# Bearer token for the platform-operator endpoints (/v1/operator/*)
OPERATOR_TOKEN=change-me
PORT=3000
REDIS_URL=redis://localhost:6379/0
# Public origin used to build shortUrl in API responses
BASE_URL=http://localhost:3000
# Click tracking (Phase 3). Without KAFKA_BROKERS the server records no clicks.
KAFKA_BROKERS=localhost:9092
CLICKS_TOPIC=clicks.raw
# Same value on every instance, kept secret: IPs are stored only as salted hashes.
IP_HASH_SALT=change-me
# Only behind a proxy that overwrites X-Forwarded-For and CF-IPCountry.
TRUST_PROXY=false
TEST_KAFKA_BROKERS=localhost:9092
